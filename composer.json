{
    "name": "ugarit/lsp",
    "description": "The Ugarit language server.",
    "keywords": [
        "ugarit",
        "language-server",
        "lsp",
        "php"
    ],
    "homepage": "https://github.com/ugarit/lsp",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/lsp/issues",
        "source": "https://github.com/ugarit/lsp"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2.0"
    },
    "require-dev": {
        "amphp/amp": "^3.0",
        "amphp/byte-stream": "^2.1",
        "ugarit-zero/framework": "^12.0",
        "ugarit/pint": "^1.00.00",
        "microsoft/tolerant-php-parser": "^0.1.2",
        "mockery/mockery": "^1.6.11",
        "pestphp/pest": "^4.0",
        "stillat/blade-parser": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "app/Lsp/Data/Templates/global.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/snippets/"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "builds/ugarit-lsp"
    ],
    "scripts": {
        "pre-autoload-dump": [
            "test -f fix-class-resolutions.php && php fix-class-resolutions.php || true"
        ]
    },
    "version": "1.00.00"
}
